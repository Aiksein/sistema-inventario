{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/httpd/access_log",
            "log_group_name": "/sistema-inventario/aplicacion",
            "log_stream_name": "apache-access-{instance_id}",
            "timezone": "LOCAL"
          },
          {
            "file_path": "/var/log/httpd/error_log",
            "log_group_name": "/sistema-inventario/aplicacion",
            "log_stream_name": "apache-error-{instance_id}",
            "timezone": "LOCAL"
          }
        ]
      }
    }
  }
}
